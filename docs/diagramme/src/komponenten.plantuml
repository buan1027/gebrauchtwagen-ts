@startuml
!theme plain
top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 55
skinparam ranksep 45

package "src" {
    component "app.mts\nHono App" as app

    package "rest" {
        component "gebrauchtwagen-router" as rest_router
        component "read-router\nwrite-router" as rest_routes
        component "validation\nheaders/statuscode" as rest_helpers
    }

    package "graphql" {
        component "graphql-app" as graphql_app
        component "query-handler\nmutation-handler" as gql_handlers
        component "types/errors" as gql_types
    }

    package "monitoring" {
        component "prometheus-router" as prometheus
        component "metrics middleware" as metrics
    }

    package "service" {
        interface "ReadService" as read_service
        interface "WriteService" as write_service
        component "Prisma Service" as prisma_service
        component "pageable" as pageable
    }

    component "container.mts\nDefault Services" as container

    package "config" {
        component "env/server/logger" as cfg
        component "prisma-client" as prisma_client
    }
}

app --> rest_router : REST
app --> graphql_app : GraphQL
app --> prometheus : Metriken
app --> container : Services
app --> cfg : Konfiguration

rest_router --> rest_routes
rest_router --> rest_helpers
graphql_app --> gql_handlers
graphql_app --> gql_types
metrics -[hidden]- prometheus

rest_routes --> read_service
rest_routes --> write_service
gql_handlers --> read_service
gql_handlers --> write_service
container --> prisma_service

prisma_service ..|> read_service
prisma_service ..|> write_service
read_service --> pageable
prisma_service --> prisma_client
@enduml

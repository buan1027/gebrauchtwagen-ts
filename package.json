{
  "name": "gebrauchtwagen-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma and TypeScript base project for the Gebrauchtwagen aggregate.",
  "keywords": [
    "Bun",
    "Prisma",
    "PostgreSQL",
    "TypeScript"
  ],
  "license": "GPL-3.0",
  "author": "Juergen Zimmermann <Juergen.Zimmermann@h-ka.de> (https://www.h-ka.de)",
  "type": "module",
  "scripts": {
    "asciidoctor": "node scripts/asciidoctor.mts",
    "build": "bun build --compile --sourcemap ./src/beispiele.mts",
    "build:write": "bun build --compile --sourcemap ./src/beispiele-write.mts",
    "dependency-check": "bun scripts/dependency-check.mts",
    "dev": "bun --watch src/index.mts",
    "eslint": "eslint --concurrency auto src test package.json prisma.config.ts",
    "k6": "k6 run test\\lasttest\\script.ts",
    "prettier": "prettier -w \"src/**/*.mts\" \"test/**/*.mts\" \"package.json\" \".github/**/*.yml\"",
    "prettier:check": "prettier --cache --check \"src/**/*.mts\" \"test/**/*.mts\" \"package.json\" \".github/**/*.yml\"",
    "prisma:generate": "bun --env-file=.env prisma generate",
    "sonar": "bun scripts/sonar-scanner.mts",
    "start": "bun src/index.mts",
    "test": "vitest run --pool=threads",
    "tsc": "tsc --pretty",
    "tsgo": "tsgo --stableTypeOrdering"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "hono": "4.12.14",
    "lodash": "4.17.23"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "@prisma/sqlcommenter-query-insights": "7.7.0",
    "dotenv": "17.4.2",
    "hono": "4.12.14",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "smol-toml": "1.6.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/js": "10.0.1",
    "@hono/node-server": "1.19.14",
    "@prettier/plugin-oxc": "0.1.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.12",
    "@types/eslint-plugin-security": "3.0.1",
    "@types/pg": "8.20.0",
    "@vitest/eslint-plugin": "1.6.16",
    "eslint": "10.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-package-json": "0.91.1",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-unicorn": "64.0.0",
    "globals": "17.5.0",
    "jiti": "2.6.1",
    "leasot": "14.4.0",
    "prettier": "3.8.3",
    "prisma": "7.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2",
    "vitest": "4.1.5"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.3.13",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "version": "1.3.13",
      "onFail": "error"
    }
  }
}
